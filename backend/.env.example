DATABASE_URL=postgresql+psycopg://gush_ball:gush_ball@localhost:5432/gush_ball
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))" (min 32 chars, required)
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-chars
CORS_ORIGINS=["http://localhost:5173"]
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=gush-ball-media
OBJECT_STORAGE_ACCESS_KEY_ID=change-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me
OBJECT_STORAGE_PUBLIC_URL=https://media.gushball.example
OBJECT_STORAGE_REGION=auto
ENABLE_DOCS=true
# Optional: site origin for password-reset links and the Google redirect URI
PUBLIC_URL=http://localhost:5173
# Optional: "Sign in with Google" (enabled only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: password-reset email (without SMTP_HOST the reset link is logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: BBStats Streamlit app + headers-only template sheet
STATS_URL=https://bbstats.streamlit.app/
STATS_TEMPLATE_URL=https://docs.google.com/spreadsheets/d/1h_lffOupvPpI7n2hzTbR_hqL8D9yeaTF3bWO4bwoOvQ/
