# Real client IP behind Coolify's proxy, for the backend's per-IP rate limits (#266). Both halves are load-bearing:
# strict resolves XFF right-to-left (the left-most entry is client-spoofable), and the header_up below
# sends only that one IP (without it XFF is "<client>, <proxy>" and the backend's client_ip reads the proxy).
{
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:80 {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://www.facebook.com https://www.instagram.com https://syndication.twitter.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }
    # per-page share tags (#327) for index.html's httpInclude. Lookup failure -> 200 empty, so index.html keeps its
    # defaults instead of 500ing (httpInclude errors on >= 400)
    handle /api/og {
        uri strip_prefix /api
        reverse_proxy backend:8000 {
            # a hung backend must not hang every page: give up and fall back to the defaults
            transport http {
                response_header_timeout 2s
            }
            @failed status 4xx 5xx
            handle_response @failed {
                respond 200
            }
        }
    }
    handle_path /api/* {
        request_body {
            max_size 11MB
        }
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {client_ip}
        }
    }
    @admin path_regexp ^/([^/]+/)?admin(/|$)
    header @admin X-Robots-Tag "noindex, nofollow"
    handle /sitemap.xml {
        reverse_proxy backend:8000
    }
    handle {
        templates
        root * /srv
        try_files {path} /index.html
        file_server
    }
    handle_errors {
        @og expression {http.request.orig_uri.path} == "/api/og"
        respond @og 200
    }
}
